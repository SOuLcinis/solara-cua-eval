# Secrets — never commit. The hive keeps API keys in ~/.env.solara and
# ~/solara_live/.env; nothing in this repo should ever read or copy them.
.env
.env.*
*.key
*.pem
secrets.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Run artifacts
results/*.jsonl
results/*.json
!results/.gitkeep

# Browser profiles carry live logged-in sessions. The eval suite must never
# use the production profile — it launches fresh ephemeral ones instead.
.browser_profile/
.eval_profile*/

# Screenshots and page captures from live runs. Sent to model APIs because the
# task requires it, but never committed.
artifacts/
