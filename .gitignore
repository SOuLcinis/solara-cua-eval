# Secrets — never commit.
.env
.env.*
*.key
*.pem
secrets.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Run artifacts
results/*.jsonl
results/*.json
!results/.gitkeep

# Browser profiles carry live sessions and must never be committed.
.browser_profile/
.eval_profile*/

# Screenshots and page captures from live runs. Sent to model APIs because the
# task requires it, but never committed.
artifacts/
